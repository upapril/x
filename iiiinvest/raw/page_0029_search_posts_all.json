        "text": "论小聪明，鸡贼，奸诈，没人比过中国人！"
      },
      {
        "author_id": "925203316992196609",
        "created_at": "2022-11-23T03:45:12.000Z",
        "edit_history_tweet_ids": [
          "1595262161089331200"
        ],
        "id": "1595262161089331200",
        "public_metrics": {
          "bookmark_count": 1,

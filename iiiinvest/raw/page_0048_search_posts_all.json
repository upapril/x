      "referenced_tweets": [
        {
          "id": "1648675503375814656",
          "type": "replied_to"
        }
      ],
      "text": "三、1%= 0.5 * 3.6% * 36% = 0.6633%\n2%= 0.5 * 4.8% * 24%= 0.5774%\n3%= 0.5 * 4.8% * 16% = 0.3848%\n4%= 0.5 * 3.6% * 9% = 0.1658%\n5%= 0.5 * 2% * 4% = 0.0429%\n6%= 0.5 * 1.8% * 3% = 0.0386%\n7%= 0.5 * 0.7% * 1%=0.0035%\n8%= 0.5 * 0.8% * 1% = 0.004%\n9%= 0.5 * 0.9% * 1% = 0.0045%",
      "url": "https://x.com/iiiinvest/status/1691326205793034240"

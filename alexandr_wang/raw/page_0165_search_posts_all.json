        "public_metrics": {
          "bookmark_count": 1,
          "impression_count": 0,
          "like_count": 35,
          "quote_count": 1,
          "reply_count": 1,
          "retweet_count": 2
        },
        "text": "The @scale_AI team has found troubling gender bias in the CoNLL-2003 dataset that trains essential language systems. We’ve found that the biased distribution of names leads to biased performance at named-entity recognition.\n\nhttps://t.co/TUWSlyMC5f"
      },

              "expanded_url": "https://scale.com/blog/if-youre-de-biasing-the-model-its-too-late",
              "start": 225,
              "status": 200,
              "unwound_url": "https://scale.com/blog",
              "url": "https://t.co/TUWSlyMC5f"
            }
          ]
        },
        "id": "1295753584881971200",

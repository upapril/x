            "username": "joshelman"
          }
        ]
      },
      "id": "1467715471050883076",
      "in_reply_to_user_id": "1979921",
      "public_metrics": {
        "bookmark_count": 0,
        "impression_count": 0,
        "like_count": 3,
        "quote_count": 0,

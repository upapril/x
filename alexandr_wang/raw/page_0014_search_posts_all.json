      ],
      "text": "@argyris Dolores park!",
      "url": "https://x.com/alexandr_wang/status/1467339670719664131"
    },
    {
      "author_id": "615818451",
      "created_at": "2021-12-03T22:30:16.000Z",
      "edit_history_tweet_ids": [
        "1466897600624295936"
      ],
      "id": "1466897600624295936",
      "public_metrics": {
        "bookmark_count": 4,
        "impression_count": 0,
        "like_count": 60,
        "quote_count": 1,
        "reply_count": 1,
        "retweet_count": 3
      },
      "text": "Winning the AI race against China is a matter of national security. It’s critical for Silicon Valley companies to help guide government usage of this tech—or risk being left behind. Looking forward to discussing these issues at #RNDF2021 to foster change across the federal gov.",
      "url": "https://x.com/alexandr_wang/status/1466897600624295936"
    },
    {
      "author_id": "615818451",
      "created_at": "2021-12-02T05:20:41.000Z",

          }
        ],
        "text": "ScaleAI just released LLM leaderboards by extending GSM1K to various domains!\n\nThis can be a great complement to lmsys eval. https://t.co/U3vnEsF1nz"
      },
      {
        "author_id": "2939913921",
        "created_at": "2024-05-29T16:56:07.000Z",
        "edit_history_tweet_ids": [
          "1795861483613823449",

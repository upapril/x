      "id": "1205177496485781504",
      "lang": "en",
      "possibly_sensitive": false,
      "public_metrics": {
        "bookmark_count": 31,
        "impression_count": 0,
        "like_count": 505,
        "quote_count": 11,
        "reply_count": 13,
        "retweet_count": 60
      },
      "text": "Immigrants are used to fighting for themselves because usually nobody else will.\n\nThis breeds self-sufficiency, resourcefulness, resiliency, frugality, fierceness etc. that gets passed onto their children.\n\nI feel very lucky to have parents who immigrated to the US.",
      "url": "https://x.com/alexandr_wang/status/1205177496485781504"
    },

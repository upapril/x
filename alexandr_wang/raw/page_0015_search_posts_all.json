      ],
      "text": "Come to @scale_AI to launch your career.\n\nYour initial cohort of coworkers matters so much for the rest of your career.\n\nChoose a group of people who are impressive, kind, inspiring, and fun. https://t.co/10UPMVDjeK",
      "url": "https://x.com/alexandr_wang/status/1205357872885846016"

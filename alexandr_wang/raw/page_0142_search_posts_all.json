      "public_metrics": {
        "bookmark_count": 182,
        "impression_count": 0,
        "like_count": 584,
        "quote_count": 3,
        "reply_count": 5,
        "retweet_count": 94
      },
      "text": "A simple formula for being great at anything:\n\n1) Spend a LOT of time on it. Unreasonable amounts\n2) Find a teacher who instills a love of excellence and a love of craft\n3) Constantly seek the feedback of honest critics\n4) Treat failure as a vehicle for learning\n5) Do NOT give up",
      "url": "https://x.com/alexandr_wang/status/1464687343198105601"
    },

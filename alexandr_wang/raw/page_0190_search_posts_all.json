      "id": "1188207788838866950",
      "public_metrics": {
        "bookmark_count": 8,
        "impression_count": 0,
        "like_count": 120,
        "quote_count": 1,
        "reply_count": 4,
        "retweet_count": 18
      },
      "text": "Physics, as an approximate science, teaches you to only focus on the most significant elements.\n\nIt turns out this is very important to being effective in the real world, because there are almost always too many factors. Downsampling is critical.",
      "url": "https://x.com/alexandr_wang/status/1188207788838866950"
    },

          {
            "id": "1825990272859152826",
            "type": "replied_to"
          }
        ],
        "text": "Quantum computers will be extremely impactful in any scientific application involving Feynman processes:\n\n- simulating chemical or nuclear reactions\n- simulating materials\n\nor other popularized use cases (cryptography &amp; encryption, etc)"
      },
      {
        "author_id": "615818451",
        "conversation_id": "1825990261220036848",
        "created_at": "2024-08-20T20:16:20.000Z",
        "edit_history_tweet_ids": [
          "1825990272859152826"
        ],
        "id": "1825990272859152826",
        "in_reply_to_user_id": "615818451",
        "lang": "en",
        "public_metrics": {

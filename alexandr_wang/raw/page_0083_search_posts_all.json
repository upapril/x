          "1691903444653847008"
        ],
        "id": "1691903444653847008",
        "public_metrics": {
          "bookmark_count": 94,
          "impression_count": 90850,
          "like_count": 214,
          "quote_count": 5,
          "reply_count": 27,
          "retweet_count": 9
        },
        "text": "new homepage https://t.co/UMscSRxNmJ https://t.co/kOXWSHqdHY"
      },
      {
        "author_id": "615818451",
        "created_at": "2023-08-11T19:15:13.000Z",
        "edit_history_tweet_ids": [
          "1690079439659630592"
        ],
        "id": "1690079439659630592",
        "public_metrics": {
          "bookmark_count": 0,
          "impression_count": 8314,
          "like_count": 9,
          "quote_count": 0,
          "reply_count": 1,
          "retweet_count": 2
        },
        "text": "Second, our product page for our new Test and Evaluation offering, now available to frontier model developers building on top of our work with OpenAI and other leading labs:\n\nhttps://t.co/SU9Bao5WCu"
      },
      {
        "attachments": {
          "media_keys": [
            "3_1690079311049687040"
          ]
        },
        "author_id": "615818451",
        "created_at": "2023-08-11T19:15:12.000Z",
        "edit_history_tweet_ids": [
          "1690079436241252352"
        ],
        "id": "1690079436241252352",
        "in_reply_to_user_id": "615818451",
        "public_metrics": {
          "bookmark_count": 0,
          "impression_count": 1910,
          "like_count": 6,
          "quote_count": 0,
          "reply_count": 1,
          "retweet_count": 0
        },
        "referenced_tweets": [
          {
            "id": "1690079434425139203",
            "type": "replied_to"
          }
        ],
        "text": "Lastly, we believe this requires a whole of ecosystem approach, involving many stakeholders:\n\n- Model developers\n- Enterprises and users\n- Government\n- Third party evaluators (like Scale) https://t.co/sB4MZL9BhE"
      },
      {
        "attachments": {
          "media_keys": [
            "3_1690079157357772800"
          ]
        },
        "author_id": "615818451",
        "created_at": "2023-08-11T19:15:11.000Z",
        "edit_history_tweet_ids": [
          "1690079434425139203"
        ],
        "id": "1690079434425139203",
        "in_reply_to_user_id": "615818451",
        "public_metrics": {
          "bookmark_count": 0,
          "impression_count": 1781,
          "like_count": 3,
          "quote_count": 0,
          "reply_count": 1,
          "retweet_count": 0
        },
        "referenced_tweets": [
          {
            "id": "1690079431937916932",
            "type": "replied_to"
          }
        ],
        "text": "For capability evaluation, our approach is hybrid again.\n\nWe believe in automated methods for fast identification of performance, but most researchers do not trust fully automated evaluations for full assessments of model quality.\n\nExpert evals are a necessity for accurate evals. https://t.co/YEGmK81LFT"
      },
      {
        "attachments": {
          "media_keys": [
            "3_1690079052961579012"
          ]
        },
        "author_id": "615818451",
        "created_at": "2023-08-11T19:15:11.000Z",
        "edit_history_tweet_ids": [
          "1690079431937916932"
        ],
        "id": "1690079431937916932",
        "in_reply_to_user_id": "615818451",
        "public_metrics": {
          "bookmark_count": 2,
          "impression_count": 1720,
          "like_count": 9,
          "quote_count": 0,
          "reply_count": 1,
          "retweet_count": 1
        },
        "referenced_tweets": [
          {
            "id": "1690079430096617477",
            "type": "replied_to"
          }
        ],
        "text": "There are a number of very real risks:\n\n- Bioweapons\n- Cyberattacks\n- Bias\n- Misinformation\n- Privacy breaches\n- Critical infrastructure\n\nThis is a key problem for the future of AI https://t.co/wn8yWJqXrQ"
      },
      {
        "attachments": {
          "media_keys": [
            "3_1690078942122942464"
          ]
        },
        "author_id": "615818451",
        "created_at": "2023-08-11T19:15:10.000Z",
        "edit_history_tweet_ids": [
          "1690079430096617477"
        ],
        "id": "1690079430096617477",
        "in_reply_to_user_id": "615818451",
        "public_metrics": {
          "bookmark_count": 0,
          "impression_count": 1647,
          "like_count": 1,
          "quote_count": 0,
          "reply_count": 1,
          "retweet_count": 1
        },
        "referenced_tweets": [
          {
            "id": "1690079427747586048",
            "type": "replied_to"
          }
        ],
        "text": "For red teaming, the surface area of potential risks is extremely large. As a result, our approach involves extensive threat modeling, &amp; automated evals to identify risks.\n\nThen our process enables capable experts to identify key risks, and report them back to model developers. https://t.co/1bN3B6EXkV"
      },
      {
        "attachments": {
          "media_keys": [
            "3_1690078625918550016"
          ]
        },
        "author_id": "615818451",
        "created_at": "2023-08-11T19:15:10.000Z",
        "edit_history_tweet_ids": [
          "1690079427747586048"
        ],
        "id": "1690079427747586048",
        "in_reply_to_user_id": "615818451",
        "public_metrics": {
          "bookmark_count": 0,
          "impression_count": 1580,
          "like_count": 2,
          "quote_count": 0,
          "reply_count": 1,
          "retweet_count": 0
        },
        "referenced_tweets": [
          {
            "id": "1690079426036506624",
            "type": "replied_to"
          }
        ],
        "text": "Our platform is built to both continually monitor and evaluate capabilities, and measure risks and vulnerabilities via red teaming.\n\nIn particular, we believe in a hybrid approach to test and evaluation which involves both automated evaluation and expert evaluations. https://t.co/ZZXgvoDZhc"
      },
      {
        "author_id": "615818451",
        "created_at": "2023-08-11T19:15:09.000Z",
        "edit_history_tweet_ids": [
          "1690079426036506624"
        ],
        "id": "1690079426036506624",
        "in_reply_to_user_id": "615818451",
        "public_metrics": {
          "bookmark_count": 0,
          "impression_count": 935,
          "like_count": 4,
          "quote_count": 0,
          "reply_count": 1,
          "retweet_count": 2
        },
        "referenced_tweets": [
          {
            "id": "1690079424044216320",
            "type": "replied_to"
          }
        ],
        "text": "At @DEFCON, cybersecurity experts will be red teaming leading models from OpenAI, Anthropic, Google, and more.\n\nThey will be using @scale_ai’s platform to proactively identify vulnerabilities and report them to the model developers.\n\nhttps://t.co/XiZputDeBX"
      },
      {
        "attachments": {
          "media_keys": [
            "3_1690078391146594304"
          ]
        },
        "author_id": "615818451",
        "created_at": "2023-08-11T19:15:09.000Z",
        "edit_history_tweet_ids": [
          "1690079424044216320"
        ],
        "id": "1690079424044216320",
        "public_metrics": {
          "bookmark_count": 32,
          "impression_count": 37572,
          "like_count": 82,
          "quote_count": 1,
          "reply_count": 3,
          "retweet_count": 18
        },
        "text": "Today, alongside our collaboration with the @WhiteHouse and @DEFCON in an evaluation of the leading LLMs—\n\n@scale_ai is announcing the release of our Test and Evaluation platform and approach to enable for safe and scalable deployment of AI systems.\n\n🧵 Read thread for more 👇 https://t.co/sIhRzrWNh5"
      }

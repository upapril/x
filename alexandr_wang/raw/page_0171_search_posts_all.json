        "1335355203655139329"
      ],
      "id": "1335355203655139329",
      "in_reply_to_user_id": "615818451",
      "public_metrics": {
        "bookmark_count": 0,
        "impression_count": 0,
        "like_count": 6,
        "quote_count": 0,
        "reply_count": 1,

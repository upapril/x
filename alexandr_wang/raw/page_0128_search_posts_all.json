        "1531307989461635072"
      ],
      "id": "1531307989461635072",
      "in_reply_to_user_id": "615818451",
      "public_metrics": {
        "bookmark_count": 4,
        "impression_count": 0,
        "like_count": 28,
        "quote_count": 0,

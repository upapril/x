      "referenced_tweets": [
        {
          "id": "2075218936266998230",
          "type": "replied_to"
        }
      ],
      "text": "2/ agentic performance and tool use are where we’re leading. it has strong performance on long-running agentic tasks with a 1M token context window with active context management, and can delegate execution across parallel-running subagents https://t.co/dJ6bUGQmw3",
      "url": "https://x.com/alexandr_wang/status/2075218938687013137"

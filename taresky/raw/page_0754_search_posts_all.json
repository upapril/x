        },
        "text": "@taresky 听说出kyc账号的都分了一杯羹，而我只是单独卖账号，没人合作"
      },
      {
        "author_id": "368245720",
        "created_at": "2023-01-09T14:04:51.000Z",
        "edit_history_tweet_ids": [
          "1612450329924083712"
        ],
        "id": "1612450329924083712",
        "in_reply_to_user_id": "368245720",
        "public_metrics": {
          "bookmark_count": 0,
          "impression_count": 2833,
          "like_count": 3,
          "quote_count": 0,
          "reply_count": 1,
